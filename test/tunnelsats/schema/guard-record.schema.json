{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "raspiblitz.tunnelsats.guard/1: start guard decision record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "unit", "impl", "chain", "boot_id", "invocation_id", "decided_at", "decision", "reason",
               "detail", "flags", "announce", "verify", "at_rest", "stray"],
  "properties": {
    "schema": {"const": "raspiblitz.tunnelsats.guard/1"},
    "unit": {"type": "string", "pattern": "^[ts]?(lnd|lightningd)\\.service$"},
    "impl": {"enum": ["lnd", "cl"]},
    "chain": {"enum": ["mainnet", "testnet", "signet"]},
    "boot_id": {"type": ["string", "null"], "pattern": "^[0-9a-f-]{36}$"},
    "invocation_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{32}$"},
    "decided_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "decision": {"enum": ["noop", "blocked", "tor-only", "hybrid"]},
    "reason": {"type": "string", "pattern": "^[a-z0-9_]+(:[a-z0-9_]+)?$"},
    "detail": {"type": "string", "pattern": "^[a-z0-9_]*$"},
    "flags": {"type": "string", "pattern": "^[A-Za-z0-9.:=/ -]*$"},
    "announce": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "ipv4", "port"],
      "properties": {
        "host": {"type": ["string", "null"]},
        "ipv4": {"type": ["string", "null"]},
        "port": {"type": ["integer", "null"], "minimum": 1, "maximum": 65535}
      }
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rc", "verdict", "emergency_block", "unit", "tool_sha256", "duration_ms", "attempts"],
      "properties": {
        "rc": {"type": ["integer", "null"]},
        "verdict": {"type": ["string", "null"]},
        "emergency_block": {"type": ["boolean", "null"]},
        "unit": {"type": ["string", "null"]},
        "tool_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "duration_ms": {"type": ["integer", "null"], "minimum": 0},
        "attempts": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "at_rest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "repaired_keys", "backup"],
      "properties": {
        "status": {"enum": ["not_checked", "clean", "drift", "repaired", "unrepairable"]},
        "repaired_keys": {"type": "array", "items": {"type": "string"}},
        "backup": {"type": ["string", "null"]}
      }
    },
    "stray": {"type": "boolean"}
  }
}
