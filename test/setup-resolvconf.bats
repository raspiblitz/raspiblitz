#!/usr/bin/env bats

setup() {
  export box="$BATS_TEST_TMPDIR/node" PATH="$BATS_TEST_TMPDIR/bin:$PATH"
  mkdir -p "$box/admin/config.scripts" "$box/run/resolvconf" "$BATS_TEST_TMPDIR/bin"
  ln -s "$box/run/resolvconf/resolv.conf" "$box/resolv.conf"
  echo '# Generated by resolvconf' >"$box/run/resolvconf/resolv.conf"
  printf '#!/bin/sh\necho "$*" >> "$box/state"\n' >"$box/admin/_cache.sh"
  printf '#!/bin/sh\nprintf "dhcp=1\\nlocalip=192.0.2.2\\nonline=1\\n"\n' >"$box/admin/config.scripts/internet.sh"
  printf '#!/bin/sh\nexit "${lookup:-1}"\n' >"$BATS_TEST_TMPDIR/bin/getent"
  printf '#!/bin/sh\nprintf "%%s\\n" "$*"\n' >"$BATS_TEST_TMPDIR/bin/dialog"
  chmod +x "$box/admin/_cache.sh" "$box/admin/config.scripts/internet.sh" "$BATS_TEST_TMPDIR/bin/"*
  local root="$BATS_TEST_DIRNAME/../home.admin"
  sed -n '/^# WAIT LOOP: LOCALNET/,/^done$/p' "$root/_bootstrap.sh" |
    sed -e 's/^while true; do$/for check in once; do/' -e '/^  sleep 1$/d' \
      -e "s@/home/admin@$box/admin@g" -e "s@/etc/resolv.conf@$box/resolv.conf@g" \
      -e "s@ = /run/resolvconf/resolv.conf@ = $box/run/resolvconf/resolv.conf@" >"$box/wait"
  sed "s@/home/admin@$box/admin@g" "$root/setup.scripts/eventInfoWait.sh" >"$box/event"
  export logFile="$box/log" scenario=setup
}

@test "first boot explains missing resolvconf DNS even with numeric connectivity and recovers" {
  run bash "$box/wait"
  [ "$status" -eq 0 ]
  grep -q 'set state noInternet' "$box/state"
  local message
  message=$(sed -n 's/^set message //p' "$box/state")
  run bash "$box/event" noInternet "$message" ssh
  [[ "$output" == *'/etc/resolvconf/resolv.conf.d/base'* ]]
  [[ "$output" == *'sudo resolvconf -u'* ]]
  echo 'nameserver 2001:db8::53' >>"$box/run/resolvconf/resolv.conf"
  : >"$box/state"
  run bash "$box/wait"
  [ "$status" -eq 0 ]
  [ ! -s "$box/state" ]
}

@test "preserve working local resolution, custom resolvers and configured nodes" {
  export lookup=0
  run bash "$box/wait"
  [ "$status" -eq 0 ]; [ ! -s "$box/state" ]
  export lookup=1 scenario=ready
  run bash "$box/wait"
  [ "$status" -eq 0 ]; [ ! -s "$box/state" ]
  export scenario=setup
  rm "$box/resolv.conf"; touch "$box/resolv.conf"
  run bash "$box/wait"
  [ "$status" -eq 0 ]; [ ! -s "$box/state" ]
}
